# Supabase Project Settings -> API
# Copy this file to .env.local and fill in your project credentials.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional. Error reporting stays disabled unless a Sentry project DSN is configured.
VITE_SENTRY_DSN=
